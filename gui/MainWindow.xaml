<Window x:Class="KbdRAlt.Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kbdralt configurator" Width="880" Height="620"
        WindowStartupLocation="CenterScreen" MinWidth="720" MinHeight="500">
  <DockPanel Margin="14">

    <!-- Driver status -->
    <Border DockPanel.Dock="Top" x:Name="StatusBox" BorderThickness="1" CornerRadius="4"
            Padding="12" Margin="0,0,0,12" Background="#F7F7F7" BorderBrush="#DDD">
      <StackPanel>
        <TextBlock Style="{StaticResource Heading}" Text="Driver status"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusHint" Style="{StaticResource Muted}" Margin="0,6,0,0"
                   Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <!-- Actions -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="SaveButton" Content="Save to registry" Click="Save_Click"
              FontWeight="SemiBold"/>
      <Button Content="Reload" Click="Reload_Click"/>
      <Button Content="Load defaults" Click="Defaults_Click" ToolTip="Right Alt → Alt+Shift, CapsLock → key left of 1"/>
      <Button Content="Reset to built-in rule" Click="Reset_Click"
              ToolTip="Removes the rule table; the driver falls back to Right Alt → Alt+Shift"/>
      <TextBlock x:Name="DirtyMark" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="#B35C00" Visibility="Collapsed" Text="unsaved changes"/>
    </StackPanel>

    <!-- Rules -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Style="{StaticResource Heading}" Text="Rules" VerticalAlignment="Center"
                     Margin="0,0,12,0"/>
          <Button Content="Add rule" Click="AddRule_Click" MinWidth="80"/>
          <Button Content="Remove" Click="RemoveRule_Click" MinWidth="80"/>
        </StackPanel>
        <ListBox x:Name="RuleList" SelectionChanged="RuleList_SelectionChanged"
                 DisplayMemberPath="Summary" HorizontalContentAlignment="Stretch"/>
      </DockPanel>

      <!-- Editor for the selected rule -->
      <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
              Padding="12">
        <StackPanel x:Name="Editor" IsEnabled="False">
          <TextBlock Style="{StaticResource Heading}" Text="Selected rule"/>

          <TextBlock Text="Input key" Margin="0,6,0,3"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Capture…" Click="CaptureInput_Click"
                    Margin="6,0,0,0" MinWidth="80"/>
            <TextBox x:Name="InputBox" LostFocus="InputBox_LostFocus" VerticalContentAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="InputName" Style="{StaticResource Muted}" Margin="0,3,0,0"/>

          <TextBlock Text="Mode" Margin="0,12,0,3"/>
          <ComboBox x:Name="ModeBox" SelectionChanged="ModeBox_SelectionChanged">
            <ComboBoxItem Content="chord — emit a sequence on release"/>
            <ComboBoxItem Content="remap — replace with one key"/>
          </ComboBox>
          <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" Margin="0,3,0,0"/>

          <DockPanel Margin="0,12,0,3">
            <TextBlock Text="Output keys" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox x:Name="OutputList" Height="120" DisplayMemberPath="Display"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Add…" Click="AddOutput_Click" MinWidth="60"/>
            <Button Content="Remove" Click="RemoveOutput_Click" MinWidth="70"/>
            <Button Content="↑" Click="MoveOutputUp_Click" MinWidth="32"/>
            <Button Content="↓" Click="MoveOutputDown_Click" MinWidth="32" Margin="0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
