<Window x:Class="KbdRAlt.Config.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Press a key" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Heading}" FontSize="15"
               Text="Press the key you want to use"/>

    <Border Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="1"
            Padding="14" Margin="0,8,0,10" CornerRadius="4">
      <TextBlock x:Name="Result" FontSize="18" HorizontalAlignment="Center"
                 Text="waiting…"/>
    </Border>

    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8">
      Modifiers are captured as individual keys, so press Right Alt itself rather than a
      combination. Keys are recorded as scan codes, which is what the driver works with.
    </TextBlock>

    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10">
      While this dialog is open every keystroke is captured, so the keyboard will not
      reach other applications. <Bold>Escape cancels.</Bold> Escape itself therefore
      cannot be captured here — type 01 in the field instead if you need it.
    </TextBlock>

    <Border x:Name="RemapWarning" Visibility="Collapsed"
            Background="#FFF4CE" BorderBrush="#E8C36A" BorderThickness="1"
            Padding="10" Margin="0,0,0,10" CornerRadius="4">
      <TextBlock Style="{StaticResource Muted}" Foreground="#5A4300"
                 Text="This key already matches an existing rule's output. Capture happens above the driver, so what you see is the result of that rule, not the physical key. Edit the existing rule instead of adding a new one."/>
    </Border>

    <Border x:Name="InjectedWarning" Visibility="Collapsed"
            Background="#FFF4CE" BorderBrush="#E8C36A" BorderThickness="1"
            Padding="10" Margin="0,0,0,10" CornerRadius="4">
      <TextBlock Style="{StaticResource Muted}" Foreground="#5A4300"
                 Text="That keystroke was injected by software rather than typed on a keyboard. A rule built from it may not match anything real."/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button x:Name="OkButton" Content="Use this key" IsEnabled="False" Click="Ok_Click"/>
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
